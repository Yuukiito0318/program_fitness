# Settings for the local PostgreSQL container (docker-compose.yml).
#   Copy-Item .env.example .env
# .env is git-ignored. These are local-only development values.
# Keep them in sync with DB_USERNAME / DB_PASSWORD / DB_PORT in backend/.env.

POSTGRES_USER=program_fitness
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=program_fitness_development
POSTGRES_PORT=5432
