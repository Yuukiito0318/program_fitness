# Copy this file to backend/.env and fill in the values.
#   Copy-Item backend\.env.example backend\.env
# backend/.env is git-ignored. Never commit real secrets.

# --- Local PostgreSQL (docker compose) --------------------------------------
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_PORT in the root .env.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=program_fitness
DB_PASSWORD=change_me_local_only
DB_NAME=program_fitness_development
DB_TEST_NAME=program_fitness_test

# --- Supabase (optional, not set up yet) -------------------------------------
# When set, DATABASE_URL overrides the DB_* values above.
# Get it from Supabase dashboard > Connect > "Session pooler" (works over IPv4).
# Leave this commented out to use the local database.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Rails -------------------------------------------------------------------
RAILS_MAX_THREADS=5
PORT=3000
