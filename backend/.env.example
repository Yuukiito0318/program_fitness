# Copy this file to backend/.env and fill in the values.
#   Copy-Item backend\.env.example backend\.env
# backend/.env is git-ignored. Never commit real secrets.

# --- Local PostgreSQL (docker compose) --------------------------------------
# Must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_PORT in the root .env.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=program_fitness
DB_PASSWORD=change_me_local_only
DB_NAME=program_fitness_development
DB_TEST_NAME=program_fitness_test

# --- Supabase (optional, not set up yet) -------------------------------------
# When set, DATABASE_URL overrides the DB_* values above.
# Get it from Supabase dashboard > Connect > "Session pooler" (works over IPv4).
# Leave this commented out to use the local database.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:5432/postgres?sslmode=require

# --- Rails -------------------------------------------------------------------
RAILS_MAX_THREADS=5
PORT=3000

# --- Email -------------------------------------------------------------------
# Links in account emails (verification / password reset) point to this frontend URL.
FRONTEND_URL=http://localhost:5173
# Sender address of account emails.
# When sending through Gmail, use the same Gmail address as SMTP_USERNAME.
MAIL_FROM="program fitness <no-reply@localhost>"

# --- SMTP (development, optional) --------------------------------------------
# Leave SMTP_ADDRESS commented out -> emails are saved to backend/tmp/mails/ (not sent).
# Set it -> emails are really sent. The production mail service is NOT selected yet.
#
# iCloud Mail example (requires two-factor authentication and an "app-specific password"
# created at https://account.apple.com , NOT your Apple Account password):
# SMTP_ADDRESS=smtp.mail.me.com
# SMTP_PORT=587
# SMTP_DOMAIN=icloud.com
# SMTP_USERNAME=your.address@icloud.com
# SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# SMTP_AUTHENTICATION=plain
# MAIL_FROM="program fitness <your.address@icloud.com>"
#
# Gmail example (requires 2-Step Verification and an "App password", NOT your normal password):
# SMTP_ADDRESS=smtp.gmail.com
# SMTP_PORT=587
# SMTP_DOMAIN=gmail.com
# SMTP_USERNAME=your.address@gmail.com
# SMTP_PASSWORD=xxxxxxxxxxxxxxxx
# SMTP_AUTHENTICATION=plain
