# Store text files with LF line endings in the repository.
# Keeps Ruby bin/ scripts and shell files working on Linux/macOS and in containers.
* text=auto eol=lf

# Windows-only scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.pdf binary
*.png binary
*.jpg binary
*.ico binary
