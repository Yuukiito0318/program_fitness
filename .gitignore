# Environment variables (real values must never be committed)
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/*.local

# Backend (Rails)
backend/.bundle/
backend/log/*
!backend/log/.keep
backend/tmp/*
!backend/tmp/.keep
backend/storage/*
!backend/storage/.keep
backend/public/uploads/
# Rails credential keys: never commit
backend/config/master.key
backend/config/credentials/*.key
