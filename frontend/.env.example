# Copy this file to frontend/.env.local if you need to change anything.
#   Copy-Item frontend\.env.example frontend\.env.local
# Variables starting with VITE_ are embedded in the browser bundle:
# NEVER put secrets (API keys, passwords) in VITE_ variables.

# Rails server that the Vite dev server proxies /api/* to (dev only, not exposed to the browser).
BACKEND_URL=http://localhost:3000

# Leave empty in development (requests go through the proxy).
# Set only when frontend and backend are hosted on different origins (hosting not decided yet).
VITE_API_BASE_URL=
